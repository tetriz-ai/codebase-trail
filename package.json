{
  "name": "codebase-trail",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed questions that help developers understand and remember their codebase.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetriz-ai/codebase-trail.git"
  },
  "bugs": "https://github.com/tetriz-ai/codebase-trail/issues",
  "homepage": "https://github.com/tetriz-ai/codebase-trail#readme",
  "type": "module",
  "bin": {
    "codebase-trail": "./launcher.mjs"
  },
  "files": [
    "architecture-extractors.mjs",
    "architecture-governance.mjs",
    "architecture-learning.mjs",
    "blob-extraction-cache.mjs",
    "config.mjs",
    "index.html",
    "launcher.mjs",
    "launcher-runtime.mjs",
    "module-resolution.mjs",
    "org-graph.mjs",
    "persistent-cache.mjs",
    "path-universe.mjs",
    "plugin-sdk.mjs",
    "providers/",
    "question-lifecycle.mjs",
    "quiz-store.mjs",
    "reproducibility.mjs",
    "server.mjs",
    "settings-store.mjs",
    "settings.html",
    "syntax-analysis.mjs",
    "telemetry-hooks.mjs",
    "ui-logic.mjs",
    "NOTICE",
    "SECURITY.md",
    "third_party/licenses/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTORS.md",
    "docs/",
    ".claude/skills/add-extractor/SKILL.md",
    "CLAUDE.md",
    "examples/",
    "scripts/example-session.mjs",
    "scripts/test-safety.mjs",
    ".github/assets/banner-light.svg",
    ".github/assets/banner-dark.svg",
    ".github/assets/demo.gif",
    ".github/assets/practice-question.png",
    ".github/assets/practice-answer.png",
    "scripts/install-macos.sh",
    "scripts/install-windows.ps1",
    "scripts/build-release-installers.mjs",
    "scripts/prepare-release.mjs",
    "scripts/release-documentation.mjs",
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml"
  ],
  "scripts": {
    "dev": "node launcher.mjs",
    "start": "node launcher.mjs",
    "test": "node --import ./scripts/test-safety.mjs --test *.test.mjs",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "test:browser": "node --import ./scripts/test-safety.mjs ./node_modules/@playwright/test/cli.js test",
    "test:install": "node scripts/install-smoke.mjs",
    "test:mutation": "stryker run",
    "test:ci": "npm run test:coverage && npm run test:browser && npm run test:mutation",
    "test:pr-smoke": "node pr-smoke.mjs",
    "test:architecture-smoke": "node architecture-smoke.mjs",
    "test:model-compat": "node scripts/model-compatibility-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:examples": "node scripts/run-examples.mjs",
    "demo:render": "node .github/assets/render-demo.mjs",
    "test:bootstrap": "node --test scripts/bootstrap.test.mjs",
    "test:bootstrap:native": "node scripts/bootstrap-native-smoke.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test scripts/prepare-release.test.mjs",
    "test:quality": "npm run test:coverage && npm run test:browser && npm run test:mutation"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.45.3",
    "cross-spawn": "^7.0.6",
    "fast-xml-parser": "^5.11.2",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "20.19.43",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
